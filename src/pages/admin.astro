--><!doctype html>
<html>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Admin</title>

        <!-- 🔐 Evita que Decap se inicialice como Netlify -->
        <script>
            window.CMS_MANUAL_INIT = true;
        </script>
    </head>
    <body>
        <!-- Decap CMS -->
        <script src="https://unpkg.com/decap-cms@latest/dist/decap-cms.js"
        ></script>
        <script>
            CMS.init();
        </script>
    </body>
</html>
