---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import musicJazz from "../assets/images/music-jazz.jpg";
import musicAmbiente from "../assets/images/music-ambiente.jpg";
import musicLive from "../assets/images/music-live.jpg";

// Get current date (set to start of day for comparison)
const today = new Date();
today.setHours(0, 0, 0, 0);

const allEvents = await getCollection("events");
const events = allEvents
    .filter((event) => new Date(event.data.date) >= today)
    .sort(
        (a, b) =>
            new Date(a.data.date).getTime() - new Date(b.data.date).getTime(),
    );
---

<section
    id="music"
    class="py-20 bg-olive-900 text-sand-50 overflow-hidden relative"
>
    <!-- Decorative background elements -->
    <div
        class="absolute top-0 left-0 w-64 h-64 bg-terra-500/10 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"
    >
    </div>
    <div
        class="absolute bottom-0 right-0 w-96 h-96 bg-olive-500/10 rounded-full blur-3xl translate-x-1/2 translate-y-1/2"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <!-- Text Content -->
            <div class="order-2 lg:order-1">
                <h2
                    class="text-4xl md:text-6xl font-heading font-bold mb-8 leading-tight"
                >
                    Música en Vivo
                </h2>
                <p class="text-xl text-sand-200 mb-8 font-light">
                    <span class="text-terra-400 font-medium"
                        >La Terraza Bar</span
                    > la casa de la música viva y karaoke te trae
                </p>

                <div
                    class="bg-white/5 backdrop-blur-sm p-6 rounded-lg border border-white/10 mb-8 hover:bg-white/10 transition-colors"
                >
                    <h4 class="text-xl font-bold mb-2 text-terra-400">
                        Próximo evento
                    </h4>
                    <ul class="space-y-3">
                        {
                            events.map((event) => (
                                <li class="flex justify-between border-b border-white/10 pb-2">
                                    <div class="flex flex-col">
                                        <span class="text-sm text-sand-300">
                                            {event.data.date
                                                .toLocaleDateString("es-ES", {
                                                    day: "2-digit",
                                                    month: "short",
                                                })
                                                .replace(".", "")}
                                        </span>
                                        <span class="text-xs text-terra-400 capitalize">
                                            {event.data.time}
                                        </span>
                                    </div>
                                    <span class="font-heading italic self-center">
                                        {event.data.artist}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>

            <!-- Inline Carousel -->
            <div
                class="order-1 lg:order-2 h-[500px] relative group rounded-2xl overflow-hidden shadow-2xl ring-1 ring-white/10"
            >
                <!-- Carousel Container -->
                <div id="carousel-track" class="w-full h-full relative">
                    <!-- Slide 1 -->
                    <div
                        class="carousel-slide absolute inset-0 w-full h-full transition-opacity duration-1000 opacity-100 z-10"
                    >
                        <Image
                            src={musicJazz}
                            alt="Concierto Jazz"
                            class="w-full h-full object-cover"
                            loading="eager"
                            quality={80}
                        />
                        <div
                            class="absolute inset-x-0 bottom-0 p-8 bg-gradient-to-t from-black/80 to-transparent"
                        >
                            <span
                                class="text-white font-heading text-3xl tracking-widest drop-shadow-lg"
                                >JAZZ</span
                            >
                        </div>
                    </div>

                    <!-- Slide 2 -->
                    <div
                        class="carousel-slide absolute inset-0 w-full h-full transition-opacity duration-1000 opacity-0 z-0"
                    >
                        <Image
                            src={musicAmbiente}
                            alt="Cócteles y Ambiente"
                            class="w-full h-full object-cover"
                            loading="lazy"
                            quality={80}
                        />
                        <div
                            class="absolute inset-x-0 bottom-0 p-8 bg-gradient-to-t from-black/80 to-transparent"
                        >
                            <span
                                class="text-white font-heading text-3xl tracking-widest drop-shadow-lg"
                                >AMBIENTE</span
                            >
                        </div>
                    </div>

                    <!-- Slide 3 -->
                    <div
                        class="carousel-slide absolute inset-0 w-full h-full transition-opacity duration-1000 opacity-0 z-0"
                    >
                        <Image
                            src={musicLive}
                            alt="Música en Vivo"
                            class="w-full h-full object-cover"
                            loading="lazy"
                            quality={80}
                        />
                        <div
                            class="absolute inset-x-0 bottom-0 p-8 bg-gradient-to-t from-black/80 to-transparent"
                        >
                            <span
                                class="text-white font-heading text-3xl tracking-widest drop-shadow-lg"
                                >EN VIVO</span
                            >
                        </div>
                    </div>
                </div>

                <!-- Controls -->
                <button
                    id="prev-btn"
                    class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/30 hover:bg-terra-500/80 text-white p-3 rounded-full backdrop-blur-sm transition-all opacity-0 group-hover:opacity-100 translate-x-4 group-hover:translate-x-0 z-20 cursor-pointer"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 19l-7-7 7-7"></path>
                    </svg>
                </button>
                <button
                    id="next-btn"
                    class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/30 hover:bg-terra-500/80 text-white p-3 rounded-full backdrop-blur-sm transition-all opacity-0 group-hover:opacity-100 -translate-x-4 group-hover:translate-x-0 z-20 cursor-pointer"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"></path>
                    </svg>
                </button>

                <!-- Indicators -->
                <div
                    class="absolute bottom-6 left-1/2 -translate-x-1/2 flex space-x-2 z-20"
                >
                    <button
                        class="indicator w-12 h-1 bg-white hover:bg-white transition-all rounded-full cursor-pointer"
                        data-index="0"></button>
                    <button
                        class="indicator w-2 h-1 bg-white/50 hover:bg-white transition-all rounded-full cursor-pointer"
                        data-index="1"></button>
                    <button
                        class="indicator w-2 h-1 bg-white/50 hover:bg-white transition-all rounded-full cursor-pointer"
                        data-index="2"></button>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const slides = document.querySelectorAll(".carousel-slide");
    const indicators = document.querySelectorAll(".indicator");
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");

    let currentSlide = 0;
    let slideInterval: number;

    function showSlide(index: number) {
        slides.forEach((slide, i) => {
            if (i === index) {
                slide.classList.remove("opacity-0", "z-0");
                slide.classList.add("opacity-100", "z-10");
            } else {
                slide.classList.remove("opacity-100", "z-10");
                slide.classList.add("opacity-0", "z-0");
            }
        });

        indicators.forEach((indicator, i) => {
            if (i === index) {
                indicator.classList.remove("w-2", "bg-white/50");
                indicator.classList.add("w-12", "bg-white");
            } else {
                indicator.classList.remove("w-12", "bg-white");
                indicator.classList.add("w-2", "bg-white/50");
            }
        });
    }

    function nextSlide() {
        currentSlide = (currentSlide + 1) % slides.length;
        showSlide(currentSlide);
    }

    function prevSlide() {
        currentSlide = (currentSlide - 1 + slides.length) % slides.length;
        showSlide(currentSlide);
    }

    function startSlideShow() {
        clearInterval(slideInterval);
        slideInterval = window.setInterval(nextSlide, 5000);
    }

    function resetTimer() {
        startSlideShow();
    }

    // Event Listeners
    nextBtn?.addEventListener("click", () => {
        nextSlide();
        resetTimer();
    });

    prevBtn?.addEventListener("click", () => {
        prevSlide();
        resetTimer();
    });

    indicators.forEach((indicator) => {
        indicator.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            const index = parseInt(target.dataset.index || "0");
            currentSlide = index;
            showSlide(currentSlide);
            resetTimer();
        });
    });

    // Initialize
    showSlide(0);
    startSlideShow();
</script>
