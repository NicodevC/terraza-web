---

---

<footer class="bg-olive-900 text-sand-100 py-16 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
            <!-- Brand -->
            <div class="col-span-1 md:col-span-1">
                <a
                    href="#"
                    class="text-3xl font-heading font-bold text-sand-50 tracking-wider block mb-6"
                >
                    LA TERRAZA BAR
                </a>
                <p class="text-sand-200/60 font-light leading-relaxed">
                    Pásala brutal… pero con estilo.
                </p>
            </div>

            <!-- Quick Links -->
            <div>
                <h4
                    class="text-lg font-bold text-terra-400 mb-6 uppercase tracking-wider text-sm"
                >
                    Explora
                </h4>
                <ul class="space-y-4">
                    <li>
                        <a
                            href="/"
                            class="text-sand-200 hover:text-white transition-colors"
                            >Inicio</a
                        >
                    </li>
                    <li>
                        <a
                            href="/carta"
                            class="text-sand-200 hover:text-white transition-colors"
                            >Nuestra Carta</a
                        >
                    </li>
                    <li>
                        <a
                            href="/musica"
                            class="text-sand-200 hover:text-white transition-colors"
                            >Música en Vivo</a
                        >
                    </li>
                    <li>
                        <a
                            href="/contacto"
                            class="text-sand-200 hover:text-white transition-colors"
                            >Reservas</a
                        >
                    </li>
                </ul>
            </div>

            <!-- Social -->
            <div>
                <h4
                    class="text-lg font-bold text-terra-400 mb-6 uppercase tracking-wider text-sm"
                >
                    Síguenos
                </h4>
                <div class="flex gap-4">
                    <a
                        href="https://www.facebook.com/share/1DHjbAKVpq/"
                        target="_blank"
                        class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-terra-500 transition-all hover:-translate-y-1"
                        aria-label="Facebook"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path
                                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                            ></path></svg
                        >
                    </a>
                    <a
                        href="https://wa.me/50557267782"
                        target="_blank"
                        class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-green-500 transition-all hover:-translate-y-1"
                        aria-label="WhatsApp"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                        >
                            <path
                                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <div
            class="border-t border-white/5 pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
        >
            <p class="text-sand-200/40 text-sm">
                © 2026 La Terraza Bar. Todos los derechos reservados.
            </p>
            <p class="text-sand-200/40 text-sm flex items-center gap-2">
                Desarrollado por NicoDev
            </p>
        </div>
    </div>
</footer>
