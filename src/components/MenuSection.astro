---
import { getEntry } from "astro:content";

interface MenuItem {
    name: string;
    price: string;
}

interface MenuSection {
    title: string;
    items: MenuItem[];
}

interface MenuCategory {
    title: string;
    sections: MenuSection[];
}

const menuEntry = await getEntry("menu", "main");
const menuData = (menuEntry?.data || {
    platos: { sections: [] },
    bebidas: { sections: [] },
}) as Record<string, MenuCategory>;

const categories = [
    { id: "platos", name: "Nuestros Platos" },
    { id: "bebidas", name: "Bebidas" },
];
---

<section id="menu" class="py-20 bg-sand-50">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
            <h3
                class="text-4xl md:text-5xl font-heading font-bold text-olive-900"
            >
                La Carta
            </h3>
        </div>

        <!-- Category Tabs -->
        <div class="flex flex-wrap justify-center gap-4 mb-12">
            {
                categories.map((cat, index) => (
                    <button
                        class={`px-6 py-2 rounded-full border border-olive-200 transition-all duration-300 hover:bg-olive-800 hover:text-white menu-tab ${index === 0 ? "bg-olive-800 text-white active" : "text-olive-800 bg-transparent"}`}
                        data-target={cat.id}
                    >
                        {cat.name}
                    </button>
                ))
            }
        </div>

        <!-- Menu Content -->
        <div class="max-w-5xl mx-auto">
            <div
                class="relative bg-white p-8 md:p-12 shadow-xl rounded-2xl border border-sand-200"
            >
                <!-- Subtle Paper Texture Overlay -->
                <div
                    class="absolute inset-0 opacity-[0.1] pointer-events-none mix-blend-multiply grain-texture rounded-2xl"
                >
                </div>

                <div class="relative z-10">
                    {
                        Object.entries(menuData).map(([key, category]) => (
                            <div
                                id={key}
                                class={`menu-category-content ${key === "platos" ? "" : "hidden"} animate-fade-in`}
                            >
                                <div class="space-y-16">
                                    {category.sections.map(
                                        (section: MenuSection) => (
                                            <div class="menu-sub-group">
                                                <div class="flex items-center gap-4 mb-8">
                                                    <h4 class="text-2xl font-heading font-bold text-olive-950 whitespace-nowrap uppercase tracking-widest">
                                                        {section.title}
                                                    </h4>
                                                    <div class="h-[1px] w-full bg-olive-950/10" />
                                                </div>
                                                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-2">
                                                    {section.items.map(
                                                        (item: MenuItem) => (
                                                            <div class="group flex items-baseline gap-4 p-3 rounded-md transition-all duration-300 hover:bg-terra-500/5 hover:translate-x-1 cursor-default">
                                                                <div class="flex-1 flex items-baseline gap-2">
                                                                    <span class="text-lg font-medium text-olive-900 group-hover:text-terra-800 transition-colors">
                                                                        {
                                                                            item.name
                                                                        }
                                                                    </span>
                                                                    <div class="flex-1 border-b border-dotted border-olive-950/20 translate-y-[-4px]" />
                                                                </div>
                                                                <span class="text-lg font-bold text-terra-600 whitespace-nowrap">
                                                                    {item.price}
                                                                </span>
                                                            </div>
                                                        ),
                                                    )}
                                                </div>
                                            </div>
                                        ),
                                    )}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const tabs = document.querySelectorAll(".menu-tab");
    const contents = document.querySelectorAll(".menu-category-content");

    tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
            // Update tabs
            tabs.forEach((t) => {
                t.classList.remove("bg-olive-800", "text-white");
                t.classList.add("text-olive-800", "bg-transparent");
            });
            tab.classList.remove("text-olive-800", "bg-transparent");
            tab.classList.add("bg-olive-800", "text-white");

            // Update content
            const targetId = tab.getAttribute("data-target");
            contents.forEach((content) => {
                if (content.id === targetId) {
                    content.classList.remove("hidden");
                    content.classList.add("animate-fade-in");
                } else {
                    content.classList.add("hidden");
                    content.classList.remove("animate-fade-in");
                }
            });
        });
    });
</script>

<style>
    .grain-texture {
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-out forwards;
    }
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
