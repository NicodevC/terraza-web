<section id="contact" class="py-20 bg-sand-200">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
            <h2
                class="text-terra-500 font-heading text-xl uppercase tracking-widest mb-2"
            >
                Visítanos
            </h2>
            <h3
                class="text-4xl md:text-5xl font-heading font-bold text-olive-900"
            >
                Contacto
            </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <!-- Contact Info -->
            <div
                class="bg-white p-8 rounded-2xl shadow-sm border border-sand-200 flex flex-col justify-center"
            >
                <div class="mb-8">
                    <h4
                        class="text-2xl font-heading font-bold text-olive-800 mb-6"
                    >
                        Información
                    </h4>
                    <p class="text-sand-600 mb-6">
                        Ven a disfrutar de nuestro ambiente único. No necesitas
                        reserva previa, pero si son un grupo grande, avísanos.
                    </p>
                </div>

                <div class="grid grid-cols-1 gap-8">
                    <div>
                        <h5
                            class="font-bold text-olive-900 mb-2 flex items-center gap-2"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5 text-terra-500"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                            Horario
                        </h5>
                        <p class="text-olive-800/80 ml-7">
                            Mié - Dom: 5:00 pm - 2:00 am
                        </p>
                        <p class="text-olive-800/80 ml-7">
                            Lunes - Martes: Cerrado
                        </p>
                    </div>
                    <div>
                        <h5
                            class="font-bold text-olive-900 mb-2 flex items-center gap-2"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5 text-terra-500"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                ></path>
                            </svg>
                            Contacto
                        </h5>
                        <p class="text-olive-800/80 ml-7">+50557267782</p>
                        <p class="text-olive-800/80 ml-7">
                            laterrazabar284@gmail.com
                        </p>
                    </div>
                </div>
            </div>

            <!-- Map -->
            <div
                class="h-full min-h-[400px] rounded-2xl overflow-hidden shadow-sm border border-sand-200 relative group"
            >
                <!-- Placeholder for Google Maps -->

                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3893.8919431882396!2d-86.68331382403049!3d12.589372687692023!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f7111007ad261a7%3A0x828c27adeb890c25!2sLa%20Terraza%20bar!5e0!3m2!1ses!2ses!4v1770071611803!5m2!1ses!2ses"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    class="grayscale group-hover:grayscale-0 transition-all duration-500"
                >
                </iframe>
            </div>
        </div>
    </div>
</section>
