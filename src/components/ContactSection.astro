---

---

<section id="contact" class="py-20 bg-sand-200">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
            <h2
                class="text-terra-500 font-heading text-xl uppercase tracking-widest mb-2"
            >
                Visítanos
            </h2>
            <h3
                class="text-4xl md:text-5xl font-heading font-bold text-olive-900"
            >
                Contacto y Reservas
            </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <!-- Contact Info & Form -->
            <div
                class="bg-white p-8 rounded-2xl shadow-sm border border-sand-200"
            >
                <div class="mb-8">
                    <h4
                        class="text-2xl font-heading font-bold text-olive-800 mb-6"
                    >
                        Haz tu Reserva
                    </h4>
                    <form class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <input
                                type="text"
                                placeholder="Nombre"
                                class="w-full px-4 py-3 bg-sand-50 border border-sand-200 rounded-lg focus:outline-none focus:border-terra-400 focus:ring-1 focus:ring-terra-400 transition-colors"
                            />
                            <input
                                type="tel"
                                placeholder="Teléfono"
                                class="w-full px-4 py-3 bg-sand-50 border border-sand-200 rounded-lg focus:outline-none focus:border-terra-400 focus:ring-1 focus:ring-terra-400 transition-colors"
                            />
                        </div>
                        <input
                            type="email"
                            placeholder="Email"
                            class="w-full px-4 py-3 bg-sand-50 border border-sand-200 rounded-lg focus:outline-none focus:border-terra-400 focus:ring-1 focus:ring-terra-400 transition-colors"
                        />
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <input
                                type="date"
                                class="w-full px-4 py-3 bg-sand-50 border border-sand-200 rounded-lg focus:outline-none focus:border-terra-400 focus:ring-1 focus:ring-terra-400 transition-colors text-olive-800"
                            />
                            <select
                                class="w-full px-4 py-3 bg-sand-50 border border-sand-200 rounded-lg focus:outline-none focus:border-terra-400 focus:ring-1 focus:ring-terra-400 transition-colors text-olive-800"
                            >
                                <option>2 Personas</option>
                                <option>3 Personas</option>
                                <option>4 Personas</option>
                                <option>+5 Personas</option>
                            </select>
                        </div>
                        <textarea
                            placeholder="Comentarios adicionales..."
                            rows="4"
                            class="w-full px-4 py-3 bg-sand-50 border border-sand-200 rounded-lg focus:outline-none focus:border-terra-400 focus:ring-1 focus:ring-terra-400 transition-colors"
                        ></textarea>
                        <button
                            type="submit"
                            class="w-full py-4 bg-olive-800 text-sand-50 font-bold rounded-lg hover:bg-olive-900 transition-all transform hover:-translate-y-1 shadow-lg"
                        >
                            Confirmar Reserva
                        </button>
                    </form>
                </div>

                <div class="border-t border-sand-200 pt-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <h5 class="font-bold text-olive-900 mb-2">
                                Horario
                            </h5>
                            <p class="text-olive-800/80">
                                Mar - Dom: 13:00 - 01:00
                            </p>
                            <p class="text-olive-800/80">Lunes: Cerrado</p>
                        </div>
                        <div>
                            <h5 class="font-bold text-olive-900 mb-2">
                                Contacto
                            </h5>
                            <p class="text-olive-800/80">+34 912 345 678</p>
                            <p class="text-olive-800/80">
                                reservas@terraza.com
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Map -->
            <div
                class="h-full min-h-[400px] rounded-2xl overflow-hidden shadow-sm border border-sand-200 relative group"
            >
                <!-- Placeholder for Google Maps -->

                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3893.8919431882396!2d-86.68331382403049!3d12.589372687692023!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f7111007ad261a7%3A0x828c27adeb890c25!2sLa%20Terraza%20bar!5e0!3m2!1ses!2ses!4v1770071611803!5m2!1ses!2ses"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    class="grayscale group-hover:grayscale-0 transition-all duration-500"
                >
                </iframe>
            </div>
        </div>
    </div>
</section>
