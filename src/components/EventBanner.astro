---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import cadejoBand from "../assets/images/cadejo-band.png";

// Get current date (set to start of day for comparison)
const today = new Date();
today.setHours(0, 0, 0, 0);

// Get the next upcoming event
const allEvents = await getCollection("events");
const futureEvents = allEvents
    .filter((event) => new Date(event.data.date) >= today)
    .sort(
        (a, b) =>
            new Date(a.data.date).getTime() - new Date(b.data.date).getTime(),
    );

const nextEvent = futureEvents[0];

if (!nextEvent) return null;

// Format date for display (e.g., "06 Feb")
const displayDate = nextEvent.data.date
    .toLocaleDateString("es-ES", {
        day: "2-digit",
        month: "short",
    })
    .replace(".", ""); // Remove dot from month abbreviation if present
---

<div
    id="event-banner"
    class="fixed bottom-0 left-0 right-0 z-50 transform translate-y-full transition-transform duration-700 ease-out"
>
    <div
        class="max-w-7xl mx-auto m-4 bg-gradient-to-r from-olive-800 via-olive-900 to-olive-950 border border-white/10 rounded-2xl shadow-2xl overflow-hidden relative"
    >
        <!-- Close Button -->
        <button
            id="close-banner"
            class="absolute top-3 right-3 z-10 w-8 h-8 bg-black/30 hover:bg-black/50 rounded-full flex items-center justify-center transition-all hover:scale-110 backdrop-blur-sm"
            aria-label="Cerrar banner"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-white"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>

        <!-- Banner Content -->
        <div class="flex flex-col md:flex-row items-center gap-6 p-6">
            <!-- Event Image -->
            <div
                class="flex-shrink-0 w-full md:w-48 h-48 rounded-xl overflow-hidden shadow-lg ring-4 ring-terra-500/30"
            >
                <Image
                    src={cadejoBand}
                    alt="Cadejo - Grupo de Rock"
                    class="w-full h-full object-cover"
                    loading="eager"
                    quality={85}
                />
            </div>

            <!-- Event Info -->
            <div class="flex-1 text-white text-center md:text-left">
                <div
                    class="inline-block bg-terra-500 text-white px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-3 animate-pulse shadow-lg shadow-terra-500/20"
                >
                    🎸 Próximo Evento
                </div>
                <h3
                    class="text-3xl md:text-4xl font-heading font-bold mb-2 drop-shadow-lg"
                >
                    {nextEvent.data.artist}
                </h3>
                <div class="flex flex-col md:flex-row gap-4 mb-4">
                    <div
                        class="flex items-center justify-center md:justify-start gap-2"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                            ></path>
                        </svg>
                        <span class="text-lg font-medium text-sand-100"
                            >{displayDate}</span
                        >
                    </div>
                    <div
                        class="flex items-center justify-center md:justify-start gap-2"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                        <span class="text-lg font-medium"
                            >{nextEvent.data.time}</span
                        >
                    </div>
                </div>
                <p class="text-white/90 text-sm mb-4">
                    {nextEvent.data.description}
                </p>
            </div>

            <!-- CTA Button -->
            <div class="flex-shrink-0">
                <a
                    href="/musica"
                    class="block px-8 py-4 bg-terra-500 hover:bg-terra-600 text-white rounded-full font-bold text-lg transition-all hover:scale-105 shadow-xl uppercase tracking-wide border border-white/20"
                >
                    Más Info
                </a>
            </div>
        </div>

        <!-- Decorative Elements -->
        <div
            class="absolute top-0 left-0 w-32 h-32 bg-white/10 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"
        >
        </div>
        <div
            class="absolute bottom-0 right-0 w-40 h-40 bg-terra-500/10 rounded-full blur-3xl translate-x-1/2 translate-y-1/2"
        >
        </div>
    </div>
</div>

<script define:vars={{ artist: nextEvent.data.artist }}>
    const banner = document.getElementById("event-banner");
    const closeBtn = document.getElementById("close-banner");
    // Use artist name in the key so if artist changes, banner shows again even if previous one was closed
    const BANNER_STORAGE_KEY = `event-banner-closed-${artist.toLowerCase().replace(/\s+/g, "-")}`;

    // Check if banner was previously closed in THIS session
    const wasClosed = sessionStorage.getItem(BANNER_STORAGE_KEY);

    if (!wasClosed) {
        // Show banner after a short delay
        setTimeout(() => {
            banner?.classList.remove("translate-y-full");
        }, 1500);
    }

    // Close banner and save to sessionStorage (only for this session)
    closeBtn?.addEventListener("click", () => {
        banner?.classList.add("translate-y-full");
        sessionStorage.setItem(BANNER_STORAGE_KEY, "true");
    });
</script>

<style>
    @keyframes pulse {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.7;
        }
    }

    .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
</style>
